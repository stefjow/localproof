// Copy to secrets.h (gitignored) and fill in.
//
// Generate a keypair with:   python python_generator_v2.py keygen
// Print this file's values:  python python_generator_v2.py secrets
//
// The private key stays on the device; only the public key is
// registered on the server.

#define DEVICE_ID "0001"

// Software signing key. OPTIONAL when an ATECC608 secure element is
// connected (I2C 0x60, locked, key in slot 0) — the chip is preferred
// automatically and its key never leaves the silicon. Convert the
// chip's public key for server registration with:
//   python python_generator_v2.py pem <xy-hex from hw_probe>
#define DEVICE_PRIVATE_KEY_PEM \
  "-----BEGIN PRIVATE KEY-----\n" \
  "...paste the key lines here, one per source line...\n" \
  "-----END PRIVATE KEY-----\n"

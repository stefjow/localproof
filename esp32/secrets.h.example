// Copy to secrets.h (gitignored). With an ATECC608 present, this file is
// optional — the private key lives on the chip and the device id is
// derived from its public key on first boot.
//
// Fill in DEVICE_PRIVATE_KEY_PEM only if you are running WITHOUT an
// ATECC608 (software fallback). Generate a keypair with:
//   python python_generator_v2.py keygen
// then print the secrets header with:
//   python python_generator_v2.py secrets

#define DEVICE_PRIVATE_KEY_PEM \
  "-----BEGIN PRIVATE KEY-----\n" \
  "...paste the key lines here, one per source line...\n" \
  "-----END PRIVATE KEY-----\n"

# Copy to .env (gitignored) and fill in.

# Flask session signing key. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Set to 1 to enable the Flask debugger. Never in production.
FLASK_DEBUG=0

# CARTO basemap key; without it every map tile carries an "API KEY REQUIRED"
# watermark. Free within fair use: https://carto.com/basemaps/apikey
CARTO_API_KEY=
